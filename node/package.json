{
  "name": "lmem",
  "version": "0.2.4",
  "description": "Ultra-Fast Local AI Agent Persistent Memory Engine with Neural Extractive QA & Knowledge Graph",
  "keywords": [
    "agent",
    "memory",
    "ai",
    "llm",
    "rag",
    "knowledge-graph",
    "extractive-qa",
    "sqlite",
    "onnx",
    "fastembed"
  ],
  "author": "Pathi Krishna Kanth <krishnakanthpathi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnakanthpathi/lightmem.git",
    "directory": "node"
  },
  "homepage": "https://github.com/krishnakanthpathi/lightmem#readme",
  "bugs": {
    "url": "https://github.com/krishnakanthpathi/lightmem/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "lmem": "./bin/lmem.js",
    "lightmem": "./bin/lmem.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@lmem/darwin-arm64": "0.2.4",
    "@lmem/darwin-x64": "0.2.4",
    "@lmem/linux-x64": "0.2.4",
    "@lmem/linux-arm64": "0.2.4",
    "@lmem/win32-x64": "0.2.4"
  }
}
